PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DB_RETRY_INTERVAL_MS=15000

# AI extraction (server-side only; never expose this key to the frontend)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible API base URL. The backend appends /chat/completions.
# For OpenAI:
# OPENAI_BASE_URL=https://api.openai.com/v1
# For local Ollama (no paid API key required):
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama-local
# OPENAI_MODEL=llama3.2
