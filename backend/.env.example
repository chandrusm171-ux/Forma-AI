PORT=5000
MONGODB_URI=mongodb://localhost:27017/forma-ai
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
DB_RETRY_INTERVAL_MS=15000

# Authentication: replace with a unique random secret of at least 32 characters.
# Example generator (PowerShell): [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
AUTH_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_TOKEN_TTL_SECONDS=28800
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=8

# ── AI Extraction (Ollama local by default) ──────────────────────────────
# Ollama exposes an OpenAI-compatible Chat Completions API.
# Start Ollama and pull a model first, e.g.:
#   ollama pull llama3.2
#   ollama serve
#
# No API key is required for local Ollama.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1/chat/completions
OLLAMA_MODEL=llama3.2

# Optional: switch to OpenAI (or any OpenAI-compatible cloud provider)
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions

# AI extraction abuse protection (per backend instance / in-memory)
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX=10

# Resume parser abuse protection (per backend instance / in-memory)
RESUME_RATE_LIMIT_WINDOW_MS=60000
RESUME_RATE_LIMIT_MAX=3
